{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fairy.local/schemas/building-room.json",
  "title": "FAIRY Building Room World Model",
  "type": "object",
  "required": ["schema_version", "room", "zones", "devices", "sensors"],
  "properties": {
    "schema_version": {"const": 1},
    "room": {
      "type": "object",
      "required": ["room_id", "name", "capacity"],
      "properties": {
        "room_id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "capacity": {"type": "integer", "minimum": 1},
        "capabilities": {"type": "array", "items": {"type": "string"}}
      }
    },
    "zones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["zone_id", "name", "area_m2", "height_m", "physics", "initial_state"]
      }
    },
    "devices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["device_id", "device_type", "zone_id", "rated_power_w"]
      }
    },
    "sensors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sensor_id", "zone_id", "quantity"]
      }
    }
  }
}
